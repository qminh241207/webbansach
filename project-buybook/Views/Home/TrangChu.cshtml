<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="css/bootstrap.min.css" />
</head>
<body>
        <div class="body1">
        <div class="textbox1">
            <h2>Nuôi dưỡng tâm hồn qua từng trang sách.</h2>
            <p>Khám phá những tựa sách hay nhất tháng này với ưu đãi lên đến 30%.</p>
            <button type="submit" class="button1">Khám phá ngay</button>
        </div>
        <div class="img1">
            <img src="@Url.Content("~/Images/ảnh slogan.png")" class="anh1" alt="ảnh sách">
        </div>
    </div>
    <div class="category">
        <from>
            <button class="button2" type="submit" name="" id="">Tất cả</button>
            <button class="button2" type="submit" name="" id="">Văn học</button>
            <button class="button2" type="submit" name="" id="">Kỹ năng & Tâm lý</button>
            <button class="button2" type="submit" name="" id="">Kinh tế</button>
            <button class="button2" type="submit" name="" id="">Thiếu nhi</button>
            <button class="button2" type="submit" name="" id="">Trinh thám</button>

        </from>
    </div>
    
    <div class="body2">
        
        <h2 style="text-align: center">Sách Bán Chạy Trong Tuần</h2>
        
        <div class="products">
                    
            <div class="card1"> 
                <div style="border-bottom: 1px solid #ddd;">
                    <img class="img2" src="@Url.Content("~/Images/ảnh sản phẩm.jpg")" alt="Còn chút gì để nhớ.">
                </div>
                <div class="cardbody">
                    <button class="icon1">Bán chạy</button>
                    <h4 class="cardtitle">Sách - Còn Chút Gì Để Nhớ</h4>
                    <p class="cardtext">Nguyễn Nhật Ánh</p>
                    <h6 class="cardtext">Giá: 116.000vnđ</h6>
                    <button class="btn-cart" type="submit">Thêm vào giỏ hàng</button>
                </div>
            </div>  

            <div class="card1"> 
                <div style="border-bottom: 1px solid #ddd;">
                    <img class="img3" src="@Url.Content("~/Images/ảnh sản phẩm 1.png")" alt="Đắc Nhân Tâm.">
                </div>
                <div class="cardbody">
                    <button class="icon1">Bán chạy</button>
                    <h4 class="cardtitle">Sách - Đắc Nhân Tâm</h4>
                    <p class="cardtext" style="margin-top: 36px">Dale Carnegie</p>
                    <h6 class="cardtext">Giá: 86.000vnđ</h6>
                    <button class="btn-cart" type="submit">Thêm vào giỏ hàng</button>
                </div>
            </div>

            <div class="card1"> 
                <div style="border-bottom: 1px solid #ddd;">
                    <img class="img3" src="@Url.Content("~/Images/ảnh sản phẩm 2.png")" alt="Khi Mọi Điều Không Như Ý.">
                </div>
                <div class="cardbody">
                    <button class="icon1">Bán chạy</button>
                    <h4 class="cardtitle">Sách - Khi Mọi Điều Không Như Ý</h4>
                    <p class="cardtext">Hae Min</p>
                    <h6 class="cardtext">Giá: 86.000vnđ</h6>
                    <button class="btn-cart" type="submit">Thêm vào giỏ hàng</button>
                </div>
            </div>

            <div class="card1"> 
                <div style="border-bottom: 1px solid #ddd;">
                    <img class="img3" style="width:200px;" src="@Url.Content("~/Images/ảnh sản phẩm 3.jpg")" alt="Cây Cam Ngọt Của Tôi.">
                </div>
                <div class="cardbody">
                    <button class="icon1">Bán chạy</button>
                    <h4 class="cardtitle">Sách - Cây Cam Ngọt Của Tôi</h4>
                    <p class="cardtext">José Mauro de Vasconcelos</p>
                    <h6 class="cardtext">Giá: 130.000vnđ</h6>
                    <button class="btn-cart" type="submit">Thêm vào giỏ hàng</button>
                </div>
            </div>

        </div>

    </div>
    
</body>
</html> 